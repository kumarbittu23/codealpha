{
  "name": "corner-store",
  "version": "1.0.0",
  "private": true,
  "description": "A small e-commerce storefront built with Express and SQLite",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "backup": "node src/backup-database.js",
    "migrate:postgres": "node database/postgresql/migrate-sqlite.js",
    "create-admin": "node src/create-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16"
  }
}
